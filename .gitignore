# Rust
/target/
**/*.rs.bk

# Experiment output (keep summaries, not raw runs)
/results/raw/
/results/dev/
/logs/

# Python
__pycache__/
*.pyc

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Word and Docs lock files
~$*

# Run configurations written by experiments/run_sweep.py and demo state
/runs/

# Local, per-site files: made from the .example files (docs/deployment.md)
# and tool scratch directories
.pytest_cache/
.claude/worktrees/
/config/cluster.toml
/experiments/machines.toml
/.docker-lab-keys/
# One resource plot per run: regenerate with analysis/analyze.py
/results/summary/*/figures/resources_*.png
/results/summary-*.log
